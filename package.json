{
  "name": "elevate-node-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:b2c": "npm run dev --workspace=apps/elevate-b2c",
    "dev:b2b": "npm run dev --workspace=apps/elevate-b2b",
    "build:b2c": "npm run build --workspace=apps/elevate-b2c",
    "build:b2b": "npm run build --workspace=apps/elevate-b2b",
    "build": "npm run build:b2c && npm run build:b2b"
  }
}
